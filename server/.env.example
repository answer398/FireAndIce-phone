# Copy to server/.env and adjust. Everything is optional; defaults are sane.

# ---- HTTP ----
PORT=8080
HOST=0.0.0.0
# Set to 1 when behind nginx/Caddy (X-Forwarded-For handling)
TRUST_PROXY=0
NODE_ENV=production

# ---- Socket.IO ----
# Comma-separated extra origins allowed to connect (the app is same-origin by
# default, so leave empty when the page and socket come from this server).
# Example: ALLOWED_ORIGINS=https://fb.example.com,https://www.fb.example.com
ALLOWED_ORIGINS=

# ---- Rooms ----
# How long a disconnected seat is held (30-60s recommended) before the slot
# is truly released and the room falls back to matchmaking.
SEAT_GRACE_MS=45000
# Ready→start countdown length.
COUNTDOWN_MS=3000
# Unaccepted swap-offer lifetime.
SWAP_OFFER_TTL_MS=15000
# Room code length (4-char unambiguous alphabet: no I/L/1/O/0).
ROOM_CODE_LENGTH=4
# How long a room nobody joins (or refills) is kept, in ms.
EMPTY_ROOM_TTL_MS=600000
# Safety sweep interval (expired seats / dead rooms).
SWEEP_INTERVAL_MS=30000
# Abuse guards.
MAX_ROOMS=200
RATE_CREATE_PER_MIN=6
RATE_JOIN_PER_MIN=20

# ---- Logging ----
LOG_LEVEL=info
