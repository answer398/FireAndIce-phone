server {
    listen 80;
    server_name play.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name play.example.com;
    ssl_certificate /etc/letsencrypt/live/play.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/play.example.com/privkey.pem;
    add_header Strict-Transport-Security "max-age=31536000" always;
    gzip on;
    gzip_types text/plain text/css application/javascript application/json application/wasm image/svg+xml;
    location /socket.io/ {
        proxy_pass http://fireandice:8080/socket.io/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 75s;
    }
    location / {
        proxy_pass http://fireandice:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        expires 1d;
    }
    location ~* \.(?:png|jpe?g|gif|mp3|woff2)$ {
        proxy_pass http://fireandice:8080;
        add_header Cache-Control "public, max-age=86400, immutable";
    }
}
